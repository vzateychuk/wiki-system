{
  // Сохраняет файл при переключении таба или потере фокуса окном
  "files.autoSave": "onFocusChange",

  // Опционально: задержка для сохранения по таймеру (если используется "afterDelay")
  "files.autoSaveDelay": 1000,

  // 1. Увеличиваем масштаб всего UI (боковая панель, меню, статусы, вкладки).
  // Значение 0.5 — это +10%, 1.0 — это +20% к размеру интерфейса.
  "window.zoomLevel": 0.8,

  // 2. Возвращаем (или уменьшаем) размер шрифта кода до комфортного значения.
  // Например, если ваш привычный шрифт был 14px, уменьшите его пропорционально зуму.
  "editor.fontSize": 12,

  // Опционально: настраиваем размер шрифта встроенного терминала,
  // если он тоже не должен сильно увеличиваться вместе с UI.
  "terminal.integrated.fontSize": 12
}